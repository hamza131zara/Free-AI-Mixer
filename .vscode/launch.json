{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "chrome",
      "request": "launch",
      "name": "Launch Chrome against localhost",
      "url": "http://localhost:8080",
      "webRoot": "${workspaceFolder}"
    },
    {
      "name": "SWA: Run Free AI Mixer",
      "request": "launch",
      "type": "chrome",
      "url": "http://localhost:4280",
      "preLaunchTask": "swa: start Free AI Mixer",
      "webRoot": "${workspaceFolder}",
      "timeout": 30000
    }
  ]
}