VITE_SCENE_API_BASE_URL=https://your-scene-backend.example.com
VITE_SCENE_GENERATION_PATH=/scenes/generate

# Phase 24/25 backend JWT verification + account bootstrap runtime:
# - runtime is env-gated and fail-closed by default
# - default tests use mocked/local JWKS only
# - real Supabase auth smoke is opt-in only; see docs/real-auth-runtime-smoke-runbook.md
FREE_AI_MIXER_AUTH_RUNTIME_ENABLED=0
FREE_AI_MIXER_AUTH_PROVIDER=jwt
FREE_AI_MIXER_AUTH_ISSUER=https://your-project.supabase.co/auth/v1
FREE_AI_MIXER_AUTH_AUDIENCE=authenticated
FREE_AI_MIXER_AUTH_JWKS_URI=https://your-project.supabase.co/auth/v1/.well-known/jwks.json
FREE_AI_MIXER_AUTH_JWT_KEY_MODE=remote_jwks
FREE_AI_MIXER_AUTH_ALLOWED_ALGORITHMS=RS256
FREE_AI_MIXER_WORKSPACE_RUNTIME_ENABLED=0

# Phase 24/25 backend-only Supabase DB/service-role runtime:
# - keep the service-role key backend-only
# - never create VITE_*SERVICE_ROLE* env vars
# - enable only in trusted local/staging/prod environments with real secrets
FREE_AI_MIXER_ENABLE_SUPABASE_DB=0
FREE_AI_MIXER_DB_PROVIDER=supabase
FREE_AI_MIXER_SUPABASE_URL=https://your-project.supabase.co
FREE_AI_MIXER_SUPABASE_SERVICE_ROLE_KEY=backend-service-role-key-from-secret-store

# Phase 24 frontend Supabase auth runtime:
# - use public auth-only envs only
# - frontend remains auth-only; no DB/storage access is allowed
# - do not expose any service-role key through VITE envs
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key

# Phase 25 opt-in real auth smoke:
# - disabled unless FREE_AI_MIXER_RUN_REAL_AUTH_SMOKE=1
# - use a dedicated verified test user only
# - do not use personal, admin, customer, or production owner accounts
# - do not run in CI by default
FREE_AI_MIXER_RUN_REAL_AUTH_SMOKE=0
FREE_AI_MIXER_REAL_AUTH_SMOKE_EMAIL=dedicated-verified-test-user@example.com
FREE_AI_MIXER_REAL_AUTH_SMOKE_PASSWORD=dedicated-test-user-password

# Launch Block 6 production deployment readiness placeholders:
# Frontend public env only. Never put service-role, provider, billing, SMTP, or webhook secrets in VITE_* values.
VITE_FREE_AI_MIXER_APP_ENV=staging

# Backend server-only deployment mode and CORS.
NODE_ENV=production
FREE_AI_MIXER_ALLOWED_ORIGINS=https://your-frontend.example.com

# Supabase persistence/storage. Values belong in the backend secret manager.
FREE_AI_MIXER_STORAGE_BUCKET_ARTIFACTS=generated-artifacts-private
FREE_AI_MIXER_STORAGE_BUCKET_UPLOADS=user-uploads-private
FREE_AI_MIXER_ENABLE_DB_MIGRATIONS=0

# Production artifact delivery remains backend-mediated only when separately configured.
FREE_AI_MIXER_PRODUCTION_ARTIFACT_DELIVERY_MODE=not_configured

# Credits/billing defaults. No live payment processor, checkout, webhook processing, or fake balances.
FREE_AI_MIXER_CREDITS_RUNTIME_ENABLED=0
FREE_AI_MIXER_BILLING_RUNTIME_ENABLED=0

# Generation/provider gates default disabled for production deployment readiness.
FREE_AI_MIXER_GENERATION_RUNTIME_ENABLED=0
FREE_AI_MIXER_GENERATION_PROVIDER_ADAPTER=not_configured
FREE_AI_MIXER_GENERATION_ALLOW_REAL_PROVIDER_CALLS=0
FREE_AI_MIXER_GENERATION_ROUTE_EXECUTION_MODE=disabled
FREE_AI_MIXER_GENERATION_OPENAI_IMAGE_REAL_LOCAL_SMOKE_ENABLED=0

# Local/mock-only gates must not be production defaults.
FREE_AI_MIXER_GENERATION_MOCK_EXECUTION_ADAPTER=not_configured
FREE_AI_MIXER_GENERATION_OPENAI_ADAPTER_FETCH_MODE=not_configured
FREE_AI_MIXER_GENERATION_ENABLE_LOCAL_IMAGE_PREVIEW=0

# Monitoring readiness is safe-status only and must not expose raw env values or secrets.
FREE_AI_MIXER_MONITORING_RUNTIME_ENABLED=1
